########################################################################
# Browser-safe configuration.
#
# Everything below is bundled into the public JavaScript. It is NOT secret.
# Copy this file to `.env.local` for development, and set the same values as
# repository/environment variables for the GitHub Pages build.
########################################################################

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable / anon key. Safe to ship to browsers.
# NEVER put the service role key here.
VITE_SUPABASE_ANON_KEY=

# Optional. Defaults to "<VITE_SUPABASE_URL>/functions/v1".
VITE_SUPABASE_FUNCTIONS_URL=


########################################################################
# SERVER-SIDE SECRETS — never prefix these with VITE_, never commit values.
#
# Set with:  supabase secrets set KEY=value
# or locally in supabase/functions/.env.local (gitignored).
########################################################################

# Injected automatically by the Supabase Edge Runtime in production.
# Only needed when serving functions locally.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private bucket holding the photographs.
PROTECTED_PHOTOS_BUCKET=protected-photos

# Comma-separated browser origins allowed to call the photo endpoint.
ALLOWED_ORIGINS=https://dnlvocatio.com,https://www.dnlvocatio.com,http://localhost:8080

# --- Optional owner notification -------------------------------------
# Disabled entirely unless BOTH OWNER_NOTIFICATION_EMAIL and RESEND_API_KEY
# are set. One notification per verified session, on the first photo request.
OWNER_NOTIFICATION_EMAIL=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=


########################################################################
# Local integration tests only (tests/backendAuthorization.test.ts).
########################################################################
E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_PHOTO_PATH=wedding/primephoto-24.JPG
